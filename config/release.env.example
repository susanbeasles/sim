# Copy to config/release.env (gitignored) and fill these in.
AGENT_BUNDLE_ID=com.avespoli.sim
AGENT_TEAM_ID=YOURTEAMID
AGENT_SIGNING_IDENTITY="Developer ID Application: Your Name (YOURTEAMID)"
AGENT_NOTARY_PROFILE=sim-notary

# From: ssh-keygen -lf ~/.ssh/id_yubikey.pub -E sha256
AGENT_AUTH_KEY_FINGERPRINT="SHA256:REPLACE_ME"
AGENT_VERSION=0.2.0
