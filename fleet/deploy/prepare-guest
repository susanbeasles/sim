#!/usr/bin/env bash
# Run as root inside an otherwise empty Linux sbx builder VM, before staking it.
set -euo pipefail
[[ $(id -u) == 0 ]] || exit 1
[[ $# == 3 ]] || { echo 'usage: prepare-guest WORKER_IMAGE_TAR EXPECTED_TAR_SHA PUBLIC_CA_PEM' >&2; exit 64; }
[[ $2 =~ ^[a-f0-9]{64}$ ]]
[[ $(sha256sum "$1" | cut -d' ' -f1) == "$2" ]]
apt-get update
apt-get install -y podman uidmap passt fuse-overlayfs nftables strace util-linux python3 git e2fsprogs
id simworker >/dev/null 2>&1 || useradd --uid 2000 --create-home --shell /bin/sh simworker
grep -q '^simworker:' /etc/subuid || echo 'simworker:200000:65536' >> /etc/subuid
grep -q '^simworker:' /etc/subgid || echo 'simworker:200000:65536' >> /etc/subgid
install -m 0644 "$1" /opt/sim-worker-image.tar
install -m 0644 "$3" /usr/local/share/ca-certificates/sim-fleet.crt
update-ca-certificates
echo 'Guest prepared. Save/stake only this credential-free template, then record its immutable digest.'
