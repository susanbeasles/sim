#!/usr/bin/env bash
set -euo pipefail
[[ $# == 2 ]] || { echo 'usage: package NEW_OUTPUT_DIRECTORY FIDO_KEY_PATH' >&2; exit 64; }
root=$(cd "$(dirname "$0")/.." && pwd -P)
mkdir "$1"
output=$(cd "$1" && pwd -P)
[[ $(awk '{print $1}' "$2.pub") == sk-* ]] || { echo 'FIDO key required' >&2; exit 1; }
cp -R "$root/src" "$root/bin" "$root/guest" "$root/deploy" "$output/"
chmod 0755 "$output"/guest/* "$output"/deploy/package "$output"/deploy/install-host "$output"/deploy/prepare-guest
node "$root/bin/release.mjs" manifest "$output"
ssh-keygen -Y sign -f "$2" -n agent-control "$output/release.json"
mv "$output/release.json.sig" "$output/release.sig"
echo "Release directory: $output"
